# Claves de los cursos de pago. NO se suben a GitHub.
# En Netlify van en Site configuration → Environment variables.
# Para probar en el ordenador, copia este archivo como .env y rellénalo.

# Supabase (cuentas de alumnos y compras). Project Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe (pagos). Developers → API keys y Developers → Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe se encarga del IVA (Managed Payments). Pon «no» para llevarlo tú.
STRIPE_MANAGED_PAYMENTS=si

# Bunny Stream (vídeos). Stream → tu biblioteca → API y Security
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# Dirección de la web (para volver después de pagar)
URL_WEB=https://abletonfacil.netlify.app
