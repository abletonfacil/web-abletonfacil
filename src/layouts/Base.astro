---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KofiWidget from "../components/KofiWidget.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Resuelve problemas de Ableton Live: escribe lo que te pasa y encuentra el reel, los pasos y lo que suele venir después." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <KofiWidget />
  </body>
</html>
