---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Buscador from "../components/Buscador.astro";
import ClipCard from "../components/ClipCard.astro";
import { CATEGORIAS } from "../data/categorias";
import { productosVisibles, MOSTRAR_EJEMPLOS, estiloImagen } from "../data/visibilidad";
import * as G from "../utils/garabatos";

const todas = await getCollection("fichas");
const fichas = todas.map((f) => f.data).sort((a, b) => a.titulo.localeCompare(b.titulo));

// Lo más buscado: de momento, las que tienen vídeo real primero.
const populares = todas
  .filter((f) => f.data.video)
  .map((f) => f.data.slug)
  .concat(todas.map((f) => f.data.slug))
  .filter((v, i, arr) => arr.indexOf(v) === i)
  .slice(0, 5);

const productosDestacados = productosVisibles.slice(0, 4);
---
<Base title="abletonfácil · ¿Qué te pasa con Ableton?">
  <main id="inicio">
    <div class="wrap hero">
      <div class="fondo-hero" aria-hidden="true"><div class="luz"></div><div class="tipo-gigante">Live</div></div>
      <h1>¿Qué te pasa con <em>Ableton<Fragment set:html={G.subrayado(300)} /></em>?</h1>
      <p class="lede">Escribe el problema como lo dirías en voz alta. Te sale el vídeo, los pasos y lo que suele venir después.</p>
      <Buscador fichas={fichas} populares={populares} />
      <div class="nota nota-buscar" aria-hidden="true"><Fragment set:html={G.flecha(90, 60)} /><span class="mano">escríbelo como se lo<br />dirías a un colega</span></div>
    </div>

    <!-- Cacharros en los márgenes (solo en pantallas anchas) -->
    <div class="margenes" aria-hidden="true">
      <figure class="cacharro izq" style="top:440px; --r:-5deg"><Fragment set:html={G.ns10()} /><figcaption class="mano">Suenan regular.<br />Por eso medio mundo<br />mezcla con ellos.</figcaption></figure>
      <figure class="cacharro der" style="top:560px; --r:4deg"><Fragment set:html={G.minimoog()} /><figcaption class="mano">Tres osciladores<br />y ni un menú.</figcaption></figure>
    </div>

    <section class="block" id="problemas">
      <div class="wrap">
        <div class="cab-seccion">
          <h2><Fragment set:html={G.circulo(250, 60)} />Problemas frecuentes <span class="autor">los de siempre</span></h2>
          <p class="sub">Si no sabes ni qué buscar, empieza por aquí. Cada problema es un reel con su explicación.</p>
          <figure class="gar-sec" style="--r:5deg" aria-hidden="true"><Fragment set:html={G.mpc()} /><figcaption class="mano">16 pads y una pantallita.<br />Y salieron discos enteros.</figcaption></figure>
        </div>
        <div class="tabs" id="tabs">
          <button class="tab" data-cat="all" aria-pressed="true"><i style="background:var(--fg)"></i>Todo</button>
          {Object.entries(CATEGORIAS).map(([clave, cat]) => (
            <button class="tab" data-cat={clave} aria-pressed="false"><i style={`background:${cat.color}`}></i>{cat.nombre}</button>
          ))}
        </div>
        <div class="clips" id="clips">
          {fichas.map((f, i) => (
            <ClipCard
              slug={f.slug}
              titulo={f.titulo}
              categoria={f.categoria}
              nivel={f.nivel}
              video={f.video}
              acceso={f.acceso}
              ejemplo={f.ejemplo}
              seed={i + 3}
              grande={Boolean(f.video)}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="block" id="tienda">
      <div class="wrap">
        <div class="cab-seccion">
          <h2>Tienda <span class="autor">lo que uso yo</span></h2>
          <figure class="gar-sec" style="--r:-4deg; top:-30px" aria-hidden="true"><Fragment set:html={G.tocadiscos()} /><figcaption class="mano">Antes de los samples,<br />esto.</figcaption></figure>
        </div>
        <p class="sub">Racks, proyectos y MIDI que uso en los vídeos, más las lecciones largas. Se compran en Ko-fi.</p>
        <div class="shop">
          {productosDestacados.map(([clave, p]) => (
            <div class="prod">
              {p.imagen && <img class="prod-img" src={p.imagen} alt={p.nombre} style={estiloImagen(p)} width="320" height="180" loading="lazy" />}
              <span class="kind">{p.tipo}</span>
              <h3>{p.nombre}</h3>
              <p>{p.descripcion}</p>
              <div class="buy">
                <span class="price">{p.precio}</span>
                <a class="btn yellow" href={p.enlace} target="_blank" rel="noopener">Comprar en Ko-fi</a>
              </div>
            </div>
          ))}
        </div>
        <p class="ejemplo" style="margin-top:12px">{MOSTRAR_EJEMPLOS && "Productos y precios de ejemplo · "}<a href="/tienda" style="color:var(--muted); text-decoration:underline">Ver tienda completa</a></p>
      </div>
    </section>

    <section class="block" id="sobre">
      <div class="wrap about">
        <div>
          <h2>Sobre mí</h2>
          <p>Soy @abletonfacil y hago reels cortos que resuelven una sola cosa de Ableton Live cada vez, con humor y sin rodeos.</p>
          <p>Esta web junta todos esos vídeos para que encuentres la respuesta cuando la necesitas, en mitad del tema, no tres semanas después.</p>
          <p><a class="chip" href="/sobre-mi">Saber más</a></p>
        </div>
        <div>
          <figure class="gar-inline" aria-hidden="true"><Fragment set:html={G.cascos()} /><figcaption class="mano">Siempre al mismo volumen.<br />El oído engaña.</figcaption></figure>
          <div class="socials">
            <a class="btn" href="https://www.instagram.com/abletonfacil/" target="_blank" rel="noopener">Instagram</a>
            <a class="btn" href="https://www.tiktok.com/@abletonfacil" target="_blank" rel="noopener">TikTok</a>
            <a class="btn yellow" href="https://ko-fi.com/abletonfacil" target="_blank" rel="noopener">Ko-fi</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  const tabs = document.getElementById("tabs");
  const clips = document.querySelectorAll<HTMLElement>("#clips .clip");

  tabs?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-cat]");
    if (!btn) return;
    tabs.querySelectorAll("[data-cat]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    const cat = btn.dataset.cat;
    clips.forEach((c) => {
      c.style.display = cat === "all" || c.dataset.cat === cat ? "" : "none";
    });
  });
</script>
