---
import Base from "../layouts/Base.astro";
---
<Base title="Gracias · abletonfácil" description="Petición de vídeo recibida.">
  <main>
    <section class="block" style="border-top:0">
      <div class="wrap">
        <h1 style="font-family:var(--f-display); font-weight:900; font-size:clamp(28px,5vw,44px); letter-spacing:-0.02em; margin:0 0 16px">¡Apuntado!</h1>
        <p class="lede">Me ha llegado tu petición. Es justo de donde saco las ideas para los próximos reels.</p>
        <p><a class="btn yellow" href="/">Volver a la portada</a></p>
      </div>
    </section>
  </main>
</Base>
