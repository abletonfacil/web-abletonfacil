---
import { CATEGORIAS, type CategoriaKey } from "../data/categorias";
import Pills from "./Pills.astro";
import { wave } from "../utils/wave";

interface Props {
  slug: string;
  titulo: string;
  categoria: CategoriaKey;
  nivel: string;
  video?: string;
  acceso: "gratis" | "pago";
  ejemplo?: boolean;
  seed?: number;
  /** true = tarjeta grande (las fichas con reel) */
  grande?: boolean;
}
const { slug, titulo, categoria, nivel, video, acceso, ejemplo, seed = 1, grande = false } = Astro.props;
const cat = CATEGORIAS[categoria];
---
<a class:list={["clip", { grande }]} href={`/problema/${slug}`} data-cat={categoria}>
  <span class="head" style={`background:${cat.color}`}>
    <span>{cat.nombre}</span>
    <span>{acceso === "pago" ? "€" : ""}</span>
  </span>
  <span class="body">
    {ejemplo && <span class="pill borrador fuerte">Borrador</span>}
    <strong>{titulo}</strong>
    {grande && <span class="mano-dest">✱ con su reel</span>}
    <span style={`color:${cat.color}`} set:html={wave(seed)} />
    <span class="foot"><Pills nivel={nivel} video={video} acceso={acceso} /></span>
    {grande && <span class="ver"><i aria-hidden="true">▶</i>Ver el reel y los pasos</span>}
  </span>
</a>
